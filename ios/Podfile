platform :ios, '15.5'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= [
        '$(inherited)',
        'PERMISSION_CAMERA=1',
        'PERMISSION_PHOTOS=1',
        'PERMISSION_MICROPHONE=1',
        'PERMISSION_SPEECH_RECOGNIZER=1',
      ]
      config.build_settings['EXCLUDED_ARCHS[sdk=iphonesimulator*]'] = 'i386'
    end
  end

  # Patch precompiled Google MLKit frameworks:
  # When archiving for device (IPA), ensure platform 2 (iOS device).
  # When running on simulator, patch platform 7 (iOS simulator).
  if ENV['BUILDING_IPA'] == '1' || File.exist?(File.expand_path('../.building_ipa', __FILE__))
    script_restore = <<-'PYTHON'
import struct, glob, os
pattern = b'\x32\x00\x00\x00'
for fw in glob.glob('Pods/ML*/**/*.framework/*', recursive=True):
    if not os.path.isfile(fw): continue
    try:
        with open(fw, 'rb') as f: data = bytearray(f.read())
        idx, changed = 0, False
        while True:
            pos = data.find(pattern, idx)
            if pos == -1 or pos + 12 > len(data): break
            cmd, cmdsize, platform = struct.unpack_from('<III', data, pos)
            if cmd == 0x32 and cmdsize >= 24 and platform == 7:
                struct.pack_into('<I', data, pos + 8, 2)
                changed = True
                idx = pos + cmdsize
            else:
                idx = pos + 4
        if changed:
            with open(fw, 'wb') as f: f.write(data)
    except Exception: pass
PYTHON
    system("python3", "-c", script_restore)
  else
    script = <<-'PYTHON'
import struct, glob, os
pattern = b'\x32\x00\x00\x00'
for fw in glob.glob('Pods/ML*/**/*.framework/*', recursive=True):
    if not os.path.isfile(fw): continue
    try:
        with open(fw, 'rb') as f: data = bytearray(f.read())
        idx, changed = 0, False
        while True:
            pos = data.find(pattern, idx)
            if pos == -1 or pos + 12 > len(data): break
            cmd, cmdsize, platform = struct.unpack_from('<III', data, pos)
            if cmd == 0x32 and cmdsize >= 24 and platform == 2:
                struct.pack_into('<I', data, pos + 8, 7)
                changed = True
                idx = pos + cmdsize
            else:
                idx = pos + 4
        if changed:
            with open(fw, 'wb') as f: f.write(data)
    except Exception: pass
PYTHON
    system("python3", "-c", script)
  end
end
